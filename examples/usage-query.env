# DHV Plugin Configuration for Usage Query
#
# Source this file before running usage commands:
#   source examples/usage-query.env
#   ./mkfs usage
#

# Directory where volumes are stored
export DHV_VOLUMES_DIR="/opt/nomad/volumes"

# Volume ID to query (set this to your actual volume ID)
export DHV_VOLUME_ID="abc123-def456-ghi789"

# Alternative: Direct path to volume mount (comment out if using VOLUMES_DIR + VOLUME_ID)
# export DHV_CREATED_PATH="/opt/nomad/volumes/abc123-def456-ghi789"

# Optional: Path to the plugin binary (if not in current directory)
# export PLUGIN_PATH="/usr/local/bin/mkfs"
